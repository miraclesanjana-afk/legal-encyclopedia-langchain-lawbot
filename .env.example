# ---------------------------------------------------------------------------
# Local Ollama stack (default — no paid API keys required)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Retrieval / generation
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TEMPERATURE=0

# Paths
INDEX_DIR=data/index
RAW_DIR=data/raw

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ---------------------------------------------------------------------------
# Optional cloud provider keys — only needed if you switch LLM_PROVIDER
# away from "ollama". Phase 0 validates these when present.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama            # ollama | openai | anthropic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# GitHub is authenticated via the GitHub CLI (`gh`), not a .env key.
# Run: gh auth status
